{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-v6.local/schemas/v6.2-rc3/model-capability-card.schema.json",
  "title": "World v6.2 RC3 Model Capability Card",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "adapter_id",
    "adapter_version",
    "provider_family",
    "invocation_mode",
    "capabilities",
    "governance",
    "continuity",
    "evidence"
  ],
  "properties": {
    "schema_version": {"const": "world-v6.model-capability-card.v1"},
    "adapter_id": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,159}$"},
    "adapter_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$"},
    "provider_family": {"type": "string", "pattern": "^[A-Z0-9][A-Z0-9._-]{0,79}$"},
    "model_id": {"type": ["string", "null"], "maxLength": 160},
    "invocation_mode": {
      "enum": ["CODE", "MANUAL_HOST", "LOCAL_RUNTIME", "REMOTE_API", "COUNCIL"]
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "task_types",
        "languages",
        "input_modalities",
        "structured_output",
        "tool_calling",
        "max_input_tokens",
        "max_output_tokens",
        "resolution_bindings"
      ],
      "properties": {
        "task_types": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,159}$"}
        },
        "languages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^[A-Za-z0-9-]{2,35}$"}
        },
        "input_modalities": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["TEXT", "IMAGE", "AUDIO", "DOCUMENT", "STRUCTURED_DATA"]}
        },
        "structured_output": {"type": "boolean"},
        "tool_calling": {"type": "boolean"},
        "max_input_tokens": {"type": "integer", "minimum": 1, "maximum": 10000000},
        "max_output_tokens": {"type": "integer", "minimum": 1, "maximum": 1000000},
        "resolution_bindings": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["profile_id", "profile_version", "profile_hash", "max_resolution"],
            "properties": {
              "profile_id": {"type": "string", "minLength": 1, "maxLength": 160},
              "profile_version": {"type": "string", "minLength": 1, "maxLength": 80},
              "profile_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
              "max_resolution": {"type": "string", "pattern": "^R(?:0|[1-9][0-9]*)$"}
            }
          }
        }
      }
    },
    "governance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "network_required_by_runtime",
        "api_token_required_by_runtime",
        "supported_data_classes",
        "processing_location",
        "retention_profile",
        "training_use",
        "legal_profile_ref",
        "proposal_only"
      ],
      "properties": {
        "network_required_by_runtime": {"type": "boolean"},
        "api_token_required_by_runtime": {"type": "boolean"},
        "supported_data_classes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["PUBLIC", "INTERNAL", "RESTRICTED", "SECRET"]}
        },
        "processing_location": {
          "enum": ["IN_PROCESS", "LOCAL_HOST", "USER_CONTROLLED_HOST", "REMOTE_APPROVED_REGION", "UNKNOWN"]
        },
        "retention_profile": {"type": "string", "minLength": 1, "maxLength": 160},
        "training_use": {"enum": ["PROHIBITED", "OPT_OUT", "ALLOWED", "UNKNOWN"]},
        "legal_profile_ref": {"type": "string", "minLength": 1, "maxLength": 200},
        "proposal_only": {"const": true}
      }
    },
    "continuity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["allowed_modes", "fallback_adapter_ids", "on_total_failure"],
      "properties": {
        "allowed_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"enum": ["F0_FULL", "F1_SANITIZED", "F2_LOCAL_SAFE", "F3_DEFERRED", "F4_HUMAN"]}
        },
        "fallback_adapter_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1, "maxLength": 160}
        },
        "on_total_failure": {"enum": ["SAFE_DEFER", "QUEUE_AND_ESCALATE", "TERMINAL_SAFE_FAILURE"]}
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "conformance_status", "conformance_report_ref", "verified_at"],
      "properties": {
        "level": {"enum": ["E0", "E1", "E2", "E3", "E4", "E5"]},
        "conformance_status": {"enum": ["UNTESTED", "CONTRACT_TESTED", "LIVE_TESTED", "SUSPENDED"]},
        "conformance_report_ref": {"type": ["string", "null"], "maxLength": 240},
        "verified_at": {"type": ["string", "null"], "format": "date-time"}
      }
    }
  }
}
