{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-v6.local/schemas/v6.2-rc1/resolution-profile.schema.json",
  "title": "World v6.2 RC1 Resolution Profile",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "profile_id",
    "version",
    "canonical_resolution",
    "allow_unspecified",
    "required_backbone_paths",
    "fields",
    "actions"
  ],
  "properties": {
    "profile_id": {"$ref": "#/$defs/token"},
    "version": {"$ref": "#/$defs/token"},
    "canonical_resolution": {"$ref": "#/$defs/resolution"},
    "allow_unspecified": {"const": false},
    "required_backbone_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/pointer"}
    },
    "fields": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4096,
      "items": {"$ref": "#/$defs/field"}
    },
    "actions": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/action"}
    }
  },
  "$defs": {
    "resolution": {"type": "string", "pattern": "^R(0|[1-9][0-9]*)$"},
    "token": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/-]{0,191}$"
    },
    "pointer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 512,
      "pattern": "^/(?:[^~/]|~[01])+(?:/(?:[^~/]|~[01])+)*$"
    },
    "field": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path",
        "introduced_at",
        "write_min_resolution",
        "downgrade_policy",
        "cable_id",
        "semantic_contract_id",
        "data_class",
        "expected_type",
        "required_for_actions"
      ],
      "properties": {
        "path": {"$ref": "#/$defs/pointer"},
        "introduced_at": {"$ref": "#/$defs/resolution"},
        "write_min_resolution": {"$ref": "#/$defs/resolution"},
        "downgrade_policy": {
          "enum": ["SAFE_TO_PROJECT", "READ_ONLY_WHEN_PROJECTED", "NO_DOWNGRADE"]
        },
        "cable_id": {"$ref": "#/$defs/token"},
        "semantic_contract_id": {"$ref": "#/$defs/token"},
        "data_class": {
          "enum": ["PUBLIC", "INTERNAL", "CONFIDENTIAL", "RESTRICTED"]
        },
        "expected_type": {
          "type": ["string", "null"],
          "enum": ["string", "integer", "boolean", "null", "array", "object", null]
        },
        "required_for_actions": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/token"}
        }
      }
    },
    "action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "minimum_resolution", "required_paths"],
      "properties": {
        "action": {"$ref": "#/$defs/token"},
        "minimum_resolution": {"$ref": "#/$defs/resolution"},
        "required_paths": {
          "type": "array",
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/pointer"}
        }
      }
    }
  }
}
