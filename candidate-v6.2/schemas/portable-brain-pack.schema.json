{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-v6.local/schemas/v6.2-rc2/portable-brain-pack.schema.json",
  "title": "World v6.2 RC2 Portable Brain Pack",
  "type": "object",
  "additionalProperties": false,
  "required": ["pack_id", "version", "world_id", "entity_id", "identity_ref", "dna_ref", "dna_hash", "root_constitution_ref", "prompt_contract_ref", "prompt_contract_hash", "output_contract_ref", "output_contract_hash", "templates", "allowed_task_types", "required_profile_bindings", "proposal_only", "api_optional"],
  "properties": {
    "pack_id": {"$ref": "#/$defs/token"},
    "version": {"$ref": "#/$defs/token"},
    "world_id": {"$ref": "#/$defs/token"},
    "entity_id": {"$ref": "#/$defs/token"},
    "identity_ref": {"$ref": "#/$defs/token"},
    "dna_ref": {"$ref": "#/$defs/token"},
    "dna_hash": {"$ref": "#/$defs/hash"},
    "root_constitution_ref": {"$ref": "#/$defs/token"},
    "prompt_contract_ref": {"$ref": "#/$defs/token"},
    "prompt_contract_hash": {"$ref": "#/$defs/hash"},
    "output_contract_ref": {"$ref": "#/$defs/token"},
    "output_contract_hash": {"$ref": "#/$defs/hash"},
    "templates": {"type": "object", "minProperties": 1, "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"type": "string", "minLength": 1, "maxLength": 4000}},
    "allowed_task_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/token"}},
    "required_profile_bindings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["profile_id", "version", "sha256"],
        "properties": {"profile_id": {"$ref": "#/$defs/token"}, "version": {"$ref": "#/$defs/token"}, "sha256": {"$ref": "#/$defs/hash"}}
      }
    },
    "proposal_only": {"const": true},
    "api_optional": {"const": true}
  },
  "$defs": {
    "token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,191}$"},
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
