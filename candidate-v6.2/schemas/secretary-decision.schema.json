{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://world-v6.local/schemas/v6.2-rc2/secretary-decision.schema.json",
  "title": "World v6.2 RC2 Portable Secretary Decision",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "intent", "response_kind", "template_id", "slots", "proposed_actions", "requires_approval", "confidence_millis", "evidence_refs", "uncertainties"],
  "properties": {
    "schema_version": {"const": "world-v6.secretary-decision.v1"},
    "intent": {"enum": ["GREET", "TASK_CAPTURE", "TASK_LIST", "DRAFT", "PRICE_LOOKUP", "CLARIFY", "UNKNOWN"]},
    "response_kind": {"enum": ["ACKNOWLEDGE", "TASK_PROPOSAL", "TASK_LIST", "DRAFT_READY", "PRICE_RESULT", "CLARIFICATION_REQUEST", "SAFE_DEFER"]},
    "template_id": {"$ref": "#/$defs/token"},
    "slots": {"type": "object", "propertyNames": {"$ref": "#/$defs/token"}, "additionalProperties": {"type": ["string", "integer", "boolean", "null"]}},
    "proposed_actions": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"enum": ["NONE", "PROPOSE_TASK", "PROPOSE_DRAFT", "PROPOSE_PRICE_LOOKUP", "PROPOSE_EXTERNAL_EFFECT"]}},
    "requires_approval": {"type": "boolean"},
    "confidence_millis": {"type": "integer", "minimum": 0, "maximum": 1000},
    "evidence_refs": {"type": "array", "items": {"$ref": "#/$defs/token"}},
    "uncertainties": {"type": "array", "items": {"type": "string", "maxLength": 500}}
  },
  "allOf": [
    {
      "if": {"properties": {"proposed_actions": {"contains": {"const": "PROPOSE_EXTERNAL_EFFECT"}}}},
      "then": {"properties": {"requires_approval": {"const": true}}}
    }
  ],
  "$defs": {"token": {"type": "string", "pattern": "^[A-Za-z0-9][A-Za-z0-9._:/@#-]{0,191}$"}}
}
